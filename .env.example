# Frontend build-time variables (public values only — they are embedded in the shipped JavaScript).
# Copy to .env.local for development, or set them in your hosting provider for production builds.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Public https origin of the site, without a trailing slash (used for canonical/OG tags, sitemap, robots).
VITE_SITE_URL=https://your-domain.example
# Optional: Web Push (public VAPID key). Leave empty to disable push notifications.
VITE_VAPID_PUBLIC_KEY=
