# Edge Function secrets. NEVER commit the real file.
# Set them with:  supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.)

# Public https origin of the web app. Used for DPay return/cancel URLs.
APP_BASE_URL=https://your-domain.example
# Comma-separated list of browser origins allowed to call the functions (CORS). Normally the same origin.
ALLOWED_ORIGINS=https://your-domain.example
# Shared secret for cron/webhook-style endpoints (header x-cron-secret). 32+ random characters.
CRON_SECRET=

# DPay (https://dpay.ly). Tokens and webhook secrets exist ONLY here — never in the database or the frontend.
DPAY_BASE_URL=https://dpay.ly
DPAY_TOKEN_SANDBOX=
DPAY_TOKEN_LIVE=
DPAY_WEBHOOK_SECRET_SANDBOX=
DPAY_WEBHOOK_SECRET_LIVE=

# Web Push (optional). Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.example
